% Title: VoltageEqtnFittingData_Hsieh1atm.m
% Author: Miranda Stockhausen, mstockha@umich.edu
% Date Written: 6 November 2026
% 
% % % Description: % % % 
% This file includes data digitized for the SOFC to fit the cell voltage 
% equation coefficients. All current datapoints are in units of Amps per 
% sq. centimeter, all voltage differences are in volts, and all power 
% datapoints are in Watts per sq. cm. Plots can be found at:
%
% LIST HERE

clc; clear;

%% Load Data Sets
Data = readmatrix('Hsieh2015_1atm.xlsx');

    % 750
Current_750_Hsieh = Data(:,1)'; Voltage_750_Hse = Data(:,2)';
i_750 = Data(:,3)'; Power_750 = Data(:,4)';

Current_750_Hsieh = Current_750_Hsieh(~isnan(Current_750_Hsieh));
Voltage_750 = Voltage_750(~isnan(Voltage_750));
i_750 = i_750(~isnan(i_750)); Power_750 = Power_750(~isnan(Power_750)); 
   
    % 800
Current_800 = Data(:,6)'; Voltage_800 = Data(:,7)';
i_800 = Data(:,8)'; Power_800 = Data(:,9)';

Current_800 = Current_800(~isnan(Current_800));
Voltage_800 = Voltage_800(~isnan(Voltage_800));
i_800 = i_800(~isnan(i_800)); Power_800 = Power_800(~isnan(Power_800)); 

    % 850
Current_850 = Data(:,11)'; Voltage_850 = Data(:,12)';
i_850 = Data(:,13)'; Power_850 = Data(:,14)';

Current_850 = Current_850(~isnan(Current_850));
Voltage_850 = Voltage_850(~isnan(Voltage_850));
i_850 = i_850(~isnan(i_850)); Power_850 = Power_850(~isnan(Power_850)); 